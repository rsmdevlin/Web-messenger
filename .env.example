# Database (будет установлена в Render как secret)
DATABASE_URL=mysql://user:password@host:3306/dbname

# Server
PORT=3000
NODE_ENV=development

# Frontend URL
VITE_API_URL=/api
FRONTEND_URL=http://localhost:5173

# Cookies & Security
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Production на Render:
# NODE_ENV=production
# FRONTEND_URL=https://your-render-url.onrender.com
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# DATABASE_URL=mysql://user:pass@host:3306/dbname (из Render secret)